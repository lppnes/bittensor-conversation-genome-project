{
  "name": "SN138 CGP Testnet Miner",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "forwardPorts": [8091],
  "portsAttributes": {
    "8091": { "label": "SN138 Miner Axon (testnet)", "onAutoForward": "notify" }
  },
  "postStartCommand": "gh codespace ports visibility 8091:public -c $CODESPACE_NAME 2>/dev/null || true"
}
