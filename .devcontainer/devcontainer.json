{
  "name": "SN138 Testnet Miner (CGP)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [60012],
  "portsAttributes": {
    "60012": { "label": "SN138 Miner Axon (testnet)", "onAutoForward": "notify" }
  },
  "postStartCommand": "gh codespace ports visibility 60012:public -c $CODESPACE_NAME 2>/dev/null || true; pm2 resurrect || echo 'No PM2 processes'"
}
